{
	"schemaVersion": 1,
	"id": "containerpeek",
	"version": "${version}",
	"name": "Container Peek",
	"description": "Shows the name and contents of shulker boxes, chests, barrels and other containers next to your crosshair. Client-side only: learns them when you open or place containers.",
	"authors": [
		"greysworkshop"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.greysworkshop.containerpeek.ContainerPeekClient"
		],
		"modmenu": [
			"com.greysworkshop.containerpeek.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
