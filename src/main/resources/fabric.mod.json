{
	"schemaVersion": 1,
	"id": "hoardeye",
	"version": "${version}",
	"name": "Hoard Eye",
	"description": "Shows the name and contents of shulker boxes, chests, barrels and other containers next to your crosshair, and previews shulker box contents in item tooltips. Client-side only.",
	"authors": [
		"PlayWit Creations"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"preLaunch": [
			"com.greysworkshop.hoardeye.PanelData"
		],
		"client": [
			"com.greysworkshop.hoardeye.HoardEyeClient"
		],
		"modmenu": [
			"com.greysworkshop.hoardeye.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"mixins": [
		"hoardeye.mixins.json"
	],
	"icon": "assets/hoardeye/icon.png"
}
